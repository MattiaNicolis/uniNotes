\newcommand{\lemma}[3]{%
  \vspace{5pt}%
  \begin{tcolorbox}[
    colback=red!5!white,
    colframe=red!50!black,
    title=\textbf{Lemma: #1},
    coltitle=white,
    fonttitle=\bfseries,
    arc=2mm,
