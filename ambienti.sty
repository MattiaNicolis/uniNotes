% --- AMBIENTE DEFINIZIONE ---
\newcommand{\definizione}[2]{%
  \vspace{5pt}%
  \begin{tcolorbox}[
    colback=azzurrino!5!white,
    colframe=azzurrino!50!black,
    title=\textbf{Definizione: #1},
    coltitle=white,
    fonttitle=\bfseries,
    arc=2mm,
    boxrule=1pt,
    enhanced,
    breakable
  ]
  #2
  \end{tcolorbox}
  \vspace{5pt}%
}

